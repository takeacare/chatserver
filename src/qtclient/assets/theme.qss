/* ==========================================================================
   聊天客户端统一主题
   主色 #2563eb / 悬停 #3b82f6 / 按下 #1d4ed8
   背景 #f2f5f9 / 卡片 #ffffff / 描边 #e4e8ef
   正文 #1f2430 / 次级 #5b6472 / 弱化 #98a1ad
   成功 #16a34a / 提示 #2563eb / 错误 #dc2626
   所有尺寸使用逻辑像素，字体使用 pt，随系统 DPI 缩放自动适配
   ========================================================================== */

QMainWindow,
QDialog {
    background-color: #f2f5f9;
}

QWidget {
    color: #1f2430;
    font-size: 10pt;
}

/* ---------- 文本层级 ---------- */
QLabel#AppTitle {
    font-size: 17pt;
    font-weight: bold;
    color: #172033;
}

QLabel#AppSubtitle {
    font-size: 9pt;
    color: #8b95a5;
}

QLabel#SectionTitle {
    font-size: 11pt;
    font-weight: bold;
    color: #222b3a;
}

QLabel#ConversationTitle {
    font-size: 12pt;
    font-weight: bold;
    color: #1b2434;
}

QLabel#CardCaption {
    font-size: 8.5pt;
    color: #98a1b0;
}

QLabel#HintLabel {
    font-size: 9pt;
    color: #98a1b0;
}

QLabel#StatusLabel {
    color: #6b7482;
    min-height: 20px;
}

QLabel#StatusLabel[state="idle"] {
    color: #6b7482;
}

QLabel#StatusLabel[state="ok"] {
    color: #16a34a;
}

QLabel#StatusLabel[state="info"] {
    color: #2563eb;
}

QLabel#StatusLabel[state="error"] {
    color: #dc2626;
}

/* ---------- 卡片容器 ---------- */
QFrame#Card,
QFrame#LoginCard {
    background-color: #ffffff;
    border: 1px solid #e4e8ef;
    border-radius: 14px;
}

QFrame#MessageCard {
    background-color: #ffffff;
    border: 1px solid #e4e8ef;
    border-radius: 14px;
}

QFrame#Divider {
    background-color: #eef1f6;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* ---------- 按钮 ---------- */
QPushButton {
    min-height: 32px;
    padding: 0 14px;
    border: 1px solid #dfe4ec;
    border-radius: 8px;
    background-color: #ffffff;
    color: #2b3442;
}

QPushButton:hover {
    background-color: #f3f7ff;
    border-color: #bcd2fb;
    color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #e6efff;
    border-color: #9dc0f7;
}

QPushButton:focus {
    border-color: #2563eb;
}

QPushButton:disabled {
    background-color: #f2f4f7;
    color: #b2b9c4;
    border-color: #e6e9ef;
}

QPushButton#PrimaryButton {
    min-height: 36px;
    padding: 0 22px;
    border: 1px solid #2563eb;
    border-radius: 9px;
    color: #ffffff;
    font-weight: bold;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #3b82f6, stop:1 #2563eb);
}

QPushButton#PrimaryButton:hover {
    border-color: #3b82f6;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #60a5fa, stop:1 #3b82f6);
}

QPushButton#PrimaryButton:pressed {
    border-color: #1d4ed8;
    background-color: #1d4ed8;
}

QPushButton#PrimaryButton:disabled {
    border-color: #b9cdf7;
    background-color: #b9cdf7;
    color: #f4f8ff;
}

QPushButton#GhostButton {
    background-color: transparent;
    border: 1px solid transparent;
    color: #4b5a72;
}

QPushButton#GhostButton:hover {
    background-color: #eef3fb;
    border-color: #e2eaf7;
    color: #1d4ed8;
}

QPushButton#GhostButton:pressed {
    background-color: #e2ebfb;
    border-color: #d3e1f7;
}

QPushButton#GhostButton:disabled {
    background-color: transparent;
    color: #b2b9c4;
    border-color: transparent;
}

QPushButton#SoftButton {
    background-color: #f6f9fd;
    border: 1px solid #e6ecf5;
    color: #3d4b60;
}

QPushButton#SoftButton:hover {
    background-color: #eef4fd;
    border-color: #bcd2fb;
    color: #1d4ed8;
}

QPushButton#SoftButton:pressed {
    background-color: #e3edfd;
    border-color: #a9c8f8;
}

QPushButton#SoftButton:disabled {
    background-color: #f7f8fa;
    color: #b2b9c4;
    border-color: #edf0f4;
}

/* ---------- 输入控件 ---------- */
QLineEdit,
QSpinBox {
    min-height: 32px;
    padding: 0 11px;
    border: 1px solid #dfe4ec;
    border-radius: 8px;
    background-color: #ffffff;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:hover,
QSpinBox:hover {
    border-color: #c8d4e6;
}

QLineEdit:focus,
QSpinBox:focus {
    border-color: #2563eb;
}

QLineEdit:disabled,
QSpinBox:disabled {
    background-color: #f2f4f7;
    border-color: #e6e9ef;
    color: #aab2bd;
}

QLineEdit#ComposerInput {
    border: none;
    background-color: transparent;
    padding: 8px 10px;
    min-height: 22px;
}

QLineEdit#ComposerInput:focus {
    border: none;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 20px;
    background-color: transparent;
    border: none;
}

/* ---------- 选项卡 ---------- */
QTabWidget::pane {
    border: none;
    background-color: transparent;
    top: 4px;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background-color: transparent;
    color: #5b6472;
    padding: 7px 16px;
    margin-right: 4px;
    border: 1px solid transparent;
    border-radius: 8px;
}

QTabBar::tab:hover {
    background-color: #eef3fb;
    color: #1d4ed8;
}

QTabBar::tab:selected {
    background-color: #e8f0ff;
    color: #1d4ed8;
    font-weight: bold;
}

/* ---------- 列表 ---------- */
QListWidget {
    background-color: transparent;
    border: none;
    padding: 2px;
    outline: none;
}

QListWidget::item {
    padding: 7px 8px;
    margin: 2px 2px;
    border: 1px solid transparent;
    border-radius: 9px;
    color: #3a4351;
}

QListWidget::item:hover {
    background-color: #f3f6fb;
    border-color: #eaf0fa;
}

QListWidget::item:selected {
    background-color: #e8f0ff;
    border-color: #d5e3fb;
    color: #1d4ed8;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #cdd5e0;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a9b6c8;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #cdd5e0;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a9b6c8;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---------- 菜单与状态栏 ---------- */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e8ecf2;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #eef3fb;
    color: #1d4ed8;
}

QMenuBar::item:pressed {
    background-color: #e2ebfb;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e4e8ef;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 26px 8px 14px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #e8f0ff;
    color: #1d4ed8;
}

QMenu::separator {
    height: 1px;
    background-color: #eef1f6;
    margin: 6px 8px;
}

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e8ecf2;
    color: #6b7482;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 4px 12px;
}

/* ---------- 分组框 ---------- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e4e8ef;
    border-radius: 12px;
    margin-top: 14px;
    padding: 14px 12px 10px 12px;
    font-weight: bold;
    color: #2b3442;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #5b6472;
}

/* ---------- 表格（群成员） ---------- */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e4e8ef;
    border-radius: 10px;
    gridline-color: #eef1f6;
    selection-background-color: #e8f0ff;
    selection-color: #1d4ed8;
    alternate-background-color: #fafbfd;
}

QTableWidget::item {
    padding: 6px;
}

QHeaderView::section {
    background-color: #f7f9fc;
    color: #5b6472;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #e4e8ef;
    font-weight: bold;
}

QTableCornerButton::section {
    background-color: #f7f9fc;
    border: none;
}

/* ---------- 对话框辅助控件 ---------- */
QDialogButtonBox QPushButton {
    min-width: 80px;
}

QMessageBox,
QInputDialog {
    background-color: #ffffff;
}

QToolTip {
    background-color: #1f2937;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
}

QSplitter::handle {
    background-color: transparent;
}
